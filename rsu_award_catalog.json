{
  "schema_version": 2,
  "company": "ARM",
  "purpose": "Generic ARM award catalog for mapping Fidelity/NetBenefits award names, grant dates, vesting dates, and French tax treatment.",
  "qualification_policy": {
    "primary_sources": [
      "employer_plan_document",
      "award_detail_pdf",
      "employer_payroll_or_tax_guidance"
    ],
    "fidelity_rule": "Fidelity labels identify award names, grant dates, and share sources; Fidelity labels do not by themselves prove French qualified status.",
    "workbook_fallback": {
      "enabled": true,
      "source_file": "RSUs-French_Tax_Declaration workbook",
      "rule": "If a known award is not confirmed by employer plan documents or payroll, trust the RSU workbook classification."
    }
  },
  "fidelity_share_source_labels": {
    "RS": {
      "meaning": "Restricted stock / RSU source",
      "tax_use": "Use award catalog and award documents to determine qualified vs non-qualified."
    },
    "SP": {
      "meaning": "Stock purchase / ESPP source",
      "tax_use": "Treat separately from RSU/free-share awards."
    },
    "AEPFRA": {
      "meaning": "All Employee Plan France label",
      "tax_use": "Map to the AEP France award when grant details match."
    },
    "RSUFRA": {
      "meaning": "French-related RSU label",
      "tax_use": "Map by award name, grant date, and award document."
    },
    "AN": {
      "meaning": "Annual award label",
      "tax_use": "Map by award name and grant date."
    }
  },
